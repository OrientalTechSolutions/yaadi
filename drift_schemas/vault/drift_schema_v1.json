    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"amount_minor\" INTEGER NULL, \"currency\" TEXT NULL, \"amount_is_fixed\" INTEGER NOT NULL CHECK (\"amount_is_fixed\" IN (0, 1)), \"scheduled_on\" TEXT NULL, \"due_on\" TEXT NULL, \"due_minute\" INTEGER NULL, \"recurrence\" TEXT NOT NULL DEFAULT '{\"type\":\"none\"}', \"notes\" TEXT NULL, \"reference\" TEXT NULL, \"status\" TEXT NOT NULL, \"snoozed_until\" TEXT NULL, \"completed_at\" INTEGER NULL, \"revision\" INTEGER NOT NULL DEFAULT 1, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(title) BETWEEN 1 AND 120 AND title = trim(title)), CHECK (notes IS NULL OR length(notes) BETWEEN 1 AND 1000), CHECK (reference IS NULL OR length(reference) BETWEEN 1 AND 40), CHECK ((amount_minor IS NULL) = (currency IS NULL)), CHECK (amount_minor IS NULL OR amount_minor >= 0), CHECK (currency IS NULL OR currency GLOB '[A-Z][A-Z][A-Z]'), CHECK (scheduled_on IS NULL OR scheduled_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (due_on IS NULL OR due_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (snoozed_until IS NULL OR snoozed_until GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK ((scheduled_on IS NULL) = (due_on IS NULL)), CHECK (due_on IS NOT NULL OR kind = 'task'), CHECK (due_minute IS NULL OR (due_on IS NOT NULL AND due_minute BETWEEN 0 AND 1439)), CHECK (due_on IS NOT NULL OR recurrence = '{\"type\":\"none\"}'), CHECK (kind = 'medicine' OR recurrence NOT LIKE '{\"type\":\"doses\"%'), CHECK ((status = 'open') = (completed_at IS NULL)), CHECK (snoozed_until IS NULL OR status = 'open'), CHECK (revision >= 1));"
        }
      ]
    },
