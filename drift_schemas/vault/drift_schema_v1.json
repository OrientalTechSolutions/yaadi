      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"occurrence_on\" TEXT NOT NULL, \"occurrence_minute\" INTEGER NULL, \"outcome\" TEXT NOT NULL, \"amount_minor\" INTEGER NULL, \"currency\" TEXT NULL, \"recorded_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (occurrence_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (occurrence_minute IS NULL OR occurrence_minute BETWEEN 0 AND 1439), CHECK ((amount_minor IS NULL) = (currency IS NULL)), CHECK (amount_minor IS NULL OR amount_minor >= 0), CHECK (currency IS NULL OR currency GLOB '[A-Z][A-Z][A-Z]'));"
